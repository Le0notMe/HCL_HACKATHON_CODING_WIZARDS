# Copy to .env and edit. Never commit .env.

# Matches docker-compose.yml
DATABASE_URL=mysql+pymysql://ticket_app:ticket_app@127.0.0.1:3307/ticket_assistant?charset=utf8mb4
CHROMA_PATH=./chroma_data
# Set to use a Chroma server, which is required for more than one uvicorn worker:
# CHROMA_HOST=127.0.0.1
# CHROMA_PORT=8000

# API callers. Replace these placeholder keys. With none set, every request gets a 401.
# clearance: PUBLIC, INTERNAL or RESTRICTED. can_review: may submit analyst feedback.
API_KEYS={"replace-with-itsm-key":{"name":"itsm-webhook","clearance":"INTERNAL","can_review":false},"replace-with-analyst-key":{"name":"analyst-console","clearance":"INTERNAL","can_review":true}}

# gemini needs GEMINI_API_KEY, from https://aistudio.google.com/apikey
# anthropic needs ANTHROPIC_API_KEY, and LLM_MODEL set to a Claude model.
# offline needs neither: it quotes sources by rule, for demos only.
LLM_PROVIDER=gemini
# Pinned for stable results. gemini-flash-latest follows Google's newest release, which is often overloaded.
LLM_MODEL=gemini-3.6-flash
# Tried in order when a Gemini model returns 503 (overloaded) or 429 (out of quota).
LLM_FALLBACK_MODELS=["gemini-3.5-flash-lite","gemini-flash-lite-latest"]
GEMINI_API_KEY=

# onnx runs locally. hashing is for tests only.
EMBEDDING_PROVIDER=onnx
# Leave empty to disable the reranker and score with cosine similarity.
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Starting values. Tune them on labelled data.
CACHE_SIMILARITY_THRESHOLD=0.95
CONFIDENCE_THRESHOLD=0.70
MIN_EVIDENCE_SCORE=0.50
DUPLICATE_MIN_SCORE=0.75
